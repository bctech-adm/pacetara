{
  "name": "pacetara-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "migrate": "node dist/scripts/migrate.js",
    "dev": "npm run build && node --env-file-if-exists=../.env dist/src/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
