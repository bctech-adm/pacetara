# Salin ke .env lalu isi. Atau jalankan: ./scripts/init-env.sh (membuat semua rahasia acak).
# .env TIDAK PERNAH di-commit.

# --- Umum ---
NODE_ENV=production
LOG_LEVEL=info
# Tag image dari GHCR. Kosongkan REGISTRY/IMAGE_TAG untuk membangun lokal dengan --build.
REGISTRY=ghcr.io/bctech-adm
IMAGE_TAG=latest

# --- Domain & HTTPS ---
# Lokal: API_DOMAIN=api.localhost dan ADMIN_DOMAIN=admin.localhost (sertifikat dari CA internal Caddy).
API_DOMAIN=pace-api.bimacreative.tech
ADMIN_DOMAIN=pace-admin.bimacreative.tech
# Situs publik (kebijakan privasi). Lokal: web.localhost
WEB_DOMAIN=pace.bimacreative.tech
ACME_EMAIL=admin@bimacreative.tech
# Ubah jika port 80/443 di VPS sudah dipakai layanan lain.
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=https://pace-admin.bimacreative.tech
TRUST_PROXY_HOPS=1
# URL API yang dipakai panel admin di browser. Bawaan: https://${API_DOMAIN}
# API_PUBLIC_URL=

# --- PostgreSQL ---
POSTGRES_USER=pacetara
POSTGRES_PASSWORD=GANTI
POSTGRES_DB=pacetara

# --- Redis ---
REDIS_PASSWORD=GANTI

# --- Enkripsi kolom (masing-masing: openssl rand -base64 32, harus berbeda) ---
# Kehilangan kunci ini = data terenkripsi tidak bisa dibaca. Simpan juga di pengelola kata sandi.
DATA_ENCRYPTION_KEY=GANTI
BLIND_INDEX_KEY=GANTI

# --- Login ---
# Kunci tanda tangan token akses (openssl rand -base64 32, berbeda dari kunci di atas).
JWT_SECRET=GANTI
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Client ID OAuth Google (Android + Web), dipisah koma. Kosong = tombol "Masuk dengan Google" mati.
GOOGLE_CLIENT_IDS=
# Push FCM (modul 1.9): JSON akun layanan Firebase, di-base64 satu baris (base64 -w0 sa.json). Kosong = push mati.
FCM_SERVICE_ACCOUNT_B64=
# Versi & alamat kebijakan privasi. Naikkan versinya setiap naskah berubah: pengguna baru wajib menyetujui versi terbaru.
PRIVACY_POLICY_VERSION=2026-11-10
PRIVACY_POLICY_URL=https://pace.bimacreative.tech/privasi

# --- Impor data lari (modul 2.3). Setiap penyedia aktif hanya jika variabelnya diisi. ---
# Callback OAuth memakai API_PUBLIC_URL (di atas) atau https://${API_DOMAIN}:
#   Garmin: https://<api>/v1/imports/garmin/callback   Strava: https://<api>/v1/imports/strava/callback
# Garmin Connect Developer Program (OAuth 2.0 PKCE). Endpoint push/ping yang didaftarkan di portal Garmin:
#   https://<api>/v1/imports/garmin/push/<GARMIN_PUSH_KEY>
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Kunci acak min. 32 karakter (openssl rand -hex 24), hanya untuk alamat endpoint push.
GARMIN_PUSH_KEY=
# Akses Starter Garmin: maks. 1.000 pengguna terhubung.
GARMIN_MAX_USERS=1000
# Strava API (strava.com/settings/api). Authorization Callback Domain = domain API.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Webhook Strava (opsional; tanpa ini hanya sinkron saat menghubungkan dan tombol "Sinkronkan").
# Callback langganan: https://<api>/v1/imports/strava/webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# --- Engine event (modul 2.4) ---
# Sumber scraping kalender lari. KOSONG = scraping mati (bawaan). Isi HANYA setelah memeriksa ketentuan
# layanan dan robots.txt situsnya (README "Mengaktifkan sumber scraping event"). Satu baris JSON:
#   EVENT_SCRAPE_SOURCES=[{"id":"kalender-contoh","name":"Kalender Contoh","urls":["https://kalender.contoh.id/lari"]}]
# Parser bawaan "jsonld" membaca data terstruktur schema.org Event di halaman itu.
EVENT_SCRAPE_SOURCES=
EVENT_SCRAPE_INTERVAL_HOURS=24
# Jeda minimal antar permintaan ke host yang sama (ms); Crawl-delay robots.txt yang lebih besar menang.
EVENT_SCRAPE_DELAY_MS=5000

# --- Email (OTP email dan cadangan OTP WhatsApp) ---
# SMTP_HOST kosong = kode email tidak bisa dikirim, sehingga Level 1 tidak bisa dicapai.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PaceTara <noreply@bimacreative.tech>

# --- WhatsApp OTP ---
WA_OTP_SHARED_SECRET=GANTI
WA_PROVIDER=baileys
# Isi (format 62812…) untuk login dengan kode pairing; kosongkan untuk QR di log container wa-otp.
WA_PAIRING_NUMBER=

# --- Penyimpanan objek S3 (SeaweedFS) ---
S3_ACCESS_KEY=pacetara
S3_SECRET_KEY=GANTI
S3_BUCKET=pacetara

# --- Cadangan ---
# Public key age (age-keygen di mesin pribadi; private key jangan pernah ditaruh di VPS).
BACKUP_AGE_RECIPIENT=age1GANTI
# Remote rclone di luar VPS, didefinisikan di infra/backup/config/rclone.conf
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
# Cron dalam UTC. 19:30 UTC = 02:30 WIB.
BACKUP_CRON=30 19 * * *
