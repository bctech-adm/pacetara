# Salin ke .env lalu isi. Atau jalankan: ./scripts/init-env.sh (membuat semua rahasia acak).
# .env TIDAK PERNAH di-commit.

# --- Umum ---
NODE_ENV=production
LOG_LEVEL=info
# Tag image dari GHCR. Kosongkan REGISTRY/IMAGE_TAG untuk membangun lokal dengan --build.
REGISTRY=ghcr.io/bctech-adm
IMAGE_TAG=latest

# --- Domain & HTTPS ---
# Lokal: API_DOMAIN=api.localhost dan ADMIN_DOMAIN=admin.localhost (sertifikat dari CA internal Caddy).
API_DOMAIN=pace-api.bimacreative.tech
ADMIN_DOMAIN=pace-admin.bimacreative.tech
# Situs publik (kebijakan privasi). Lokal: web.localhost
WEB_DOMAIN=pace.bimacreative.tech
ACME_EMAIL=admin@bimacreative.tech
# Ubah jika port 80/443 di VPS sudah dipakai layanan lain.
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=https://pace-admin.bimacreative.tech
TRUST_PROXY_HOPS=1
# URL API yang dipakai panel admin di browser. Bawaan: https://${API_DOMAIN}
# API_PUBLIC_URL=

# --- PostgreSQL ---
POSTGRES_USER=pacetara
POSTGRES_PASSWORD=GANTI
POSTGRES_DB=pacetara

# --- Redis ---
REDIS_PASSWORD=GANTI

# --- Enkripsi kolom (masing-masing: openssl rand -base64 32, harus berbeda) ---
# Kehilangan kunci ini = data terenkripsi tidak bisa dibaca. Simpan juga di pengelola kata sandi.
DATA_ENCRYPTION_KEY=GANTI
BLIND_INDEX_KEY=GANTI

# --- Login ---
# Kunci tanda tangan token akses (openssl rand -base64 32, berbeda dari kunci di atas).
JWT_SECRET=GANTI
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Client ID OAuth Google (Android + Web), dipisah koma. Kosong = tombol "Masuk dengan Google" mati.
GOOGLE_CLIENT_IDS=
# Push FCM (modul 1.9): JSON akun layanan Firebase, di-base64 satu baris (base64 -w0 sa.json). Kosong = push mati.
FCM_SERVICE_ACCOUNT_B64=
# Versi & alamat kebijakan privasi. Naikkan versinya setiap naskah berubah: pengguna baru wajib menyetujui versi terbaru.
PRIVACY_POLICY_VERSION=2026-11-12
PRIVACY_POLICY_URL=https://pace.bimacreative.tech/privasi

# --- Impor data lari (modul 2.3). Setiap penyedia aktif hanya jika variabelnya diisi. ---
# Callback OAuth memakai API_PUBLIC_URL (di atas) atau https://${API_DOMAIN}:
#   Garmin: https://<api>/v1/imports/garmin/callback   Strava: https://<api>/v1/imports/strava/callback
# Garmin Connect Developer Program (OAuth 2.0 PKCE). Endpoint push/ping yang didaftarkan di portal Garmin:
#   https://<api>/v1/imports/garmin/push/<GARMIN_PUSH_KEY>
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Kunci acak min. 32 karakter (openssl rand -hex 24), hanya untuk alamat endpoint push.
GARMIN_PUSH_KEY=
# Akses Starter Garmin: maks. 1.000 pengguna terhubung.
GARMIN_MAX_USERS=1000
# Strava API (strava.com/settings/api). Authorization Callback Domain = domain API.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Webhook Strava (opsional; tanpa ini hanya sinkron saat menghubungkan dan tombol "Sinkronkan").
# Callback langganan: https://<api>/v1/imports/strava/webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# --- Engine event (modul 2.4) ---
# Sumber scraping kalender lari. KOSONG = scraping mati (bawaan). Isi HANYA setelah memeriksa ketentuan
# layanan dan robots.txt situsnya (README "Mengaktifkan sumber scraping event"). Satu baris JSON:
#   EVENT_SCRAPE_SOURCES=[{"id":"kalender-contoh","name":"Kalender Contoh","urls":["https://kalender.contoh.id/lari"]}]
# Parser bawaan "jsonld" membaca data terstruktur schema.org Event di halaman itu.
EVENT_SCRAPE_SOURCES=
EVENT_SCRAPE_INTERVAL_HOURS=24
# Jeda minimal antar permintaan ke host yang sama (ms); Crawl-delay robots.txt yang lebih besar menang.
EVENT_SCRAPE_DELAY_MS=5000

# --- Langganan Google Play (modul 2.5). Kosong = "Langganan belum tersedia" di aplikasi, endpoint 503. ---
# Nama paket aplikasi di Play Console.
GOOGLE_PLAY_PACKAGE_NAME=
# JSON akun layanan Google Cloud yang diundang di Play Console (izin "Lihat data keuangan" + "Kelola pesanan
# dan langganan"), di-base64 satu baris (base64 -w0 sa.json). Boleh akun layanan yang sama dengan FCM jika
# akun itu diberi izin Play. Langkah lengkap di README "Mengaktifkan langganan Google Play".
PLAY_SERVICE_ACCOUNT_B64=
# Product ID langganan di Play Console (harga diatur di Play Console, bukan di sini).
PLAY_PRODUCT_PREMIUM=pacetara_premium
PLAY_PRODUCT_PRO=pacetara_community_pro
PLAY_PRODUCT_PRO_UNLIMITED=pacetara_community_pro_unlimited
# Real-time Developer Notifications: push subscription Pub/Sub ke https://<api>/v1/subscriptions/play/rtdn
# dengan autentikasi aktif. AUDIENCE = nilai "audience" di push subscription; EMAIL = akun layanan push-nya.
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# --- Iklan AdMob (modul 2.7) ---
# ID penerbit AdMob (pub-XXXXXXXXXXXXXXXX, AdMob → Pengaturan → Informasi akun) untuk app-ads.txt di situs publik
# (service web). Kosong = /app-ads.txt 404. ID aplikasi dan ID unit iklan BUKAN di sini: variabel repo GitHub
# ADMOB_APP_ID, ADMOB_NATIVE_FEED, ADMOB_BANNER_FEED, ADMOB_BANNER_EVENTS (ikut di APK, lihat README).
ADMOB_PUBLISHER_ID=

# App Links Android (service web): sidik jari SHA-256 sertifikat penandatangan APK, format AA:BB:...:FF, beberapa
# dipisah koma (kunci unggah CI dan, setelah rilis di Play, kunci "App signing" dari Play Console). Kosong =
# /.well-known/assetlinks.json 404 dan tautan /j/KODE membuka halaman petunjuk. Host tautan diatur di variabel
# repo GitHub APP_LINKS_HOST (ikut di APK).
ANDROID_CERT_SHA256=

# --- Email (OTP email dan cadangan OTP WhatsApp) ---
# SMTP_HOST kosong = kode email tidak bisa dikirim, sehingga Level 1 tidak bisa dicapai.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PaceTara <noreply@bimacreative.tech>

# --- WhatsApp OTP ---
WA_OTP_SHARED_SECRET=GANTI
WA_PROVIDER=baileys
# Isi (format 62812…) untuk login dengan kode pairing; kosongkan untuk QR di log container wa-otp.
WA_PAIRING_NUMBER=

# --- Penyimpanan objek S3 (SeaweedFS) ---
S3_ACCESS_KEY=pacetara
S3_SECRET_KEY=GANTI
S3_BUCKET=pacetara

# --- Cadangan ---
# Public key age (age-keygen di mesin pribadi; private key jangan pernah ditaruh di VPS).
BACKUP_AGE_RECIPIENT=age1GANTI
# Remote rclone di luar VPS, didefinisikan di infra/backup/config/rclone.conf
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
# Cron dalam UTC. 19:30 UTC = 02:30 WIB.
BACKUP_CRON=30 19 * * *

# --- Verifikasi Level 2 / KTP (modul 3.1) ---
# local = OCR + pencocokan wajah self-hosted di dalam API (foto hanya di memori, tanpa pihak ketiga); off = 503.
KYC_ENGINE=local
# Ambang keputusan (0..1). Kalibrasi dengan foto sukarelawan: node dist/scripts/kyc-smoke.js <ktp> <selfie> <nik> <nama>
KYC_FACE_PASS=0.6
KYC_FACE_REJECT=0.45
KYC_LIVENESS_MIN=0.5
# Versi naskah layar persetujuan verifikasi di aplikasi; naikkan jika naskahnya diubah.
KYC_CONSENT_VERSION=2026-11-12
# Level minimum untuk MEMBUAT komunitas baru (PRD: 2). Turunkan ke 1 sementara jika mesin verifikasi bermasalah.
COMMUNITY_OWNER_MIN_LEVEL=2

# --- Marketplace (modul 3.2) dan pembayaran web (3.2/3.3) ---
# Midtrans: biaya listing, boost, dan banner sponsor, dibayar di dasbor web (DASHBOARD_URL), bukan di aplikasi.
# Kosong = pembayaran web 503. Payment Notification URL di dasbor Midtrans: https://<api>/v1/payments/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
DASHBOARD_URL=https://pace-admin.bimacreative.tech/dasbor
# Xendit xenPlatform (split payment). Ketiganya wajib; kosong = "bayar di aplikasi" mati (afiliasi/listing berbayar tetap jalan).
# Callback di dasbor Xendit: invoice → https://<api>/v1/market/xendit/invoice, status akun xenPlatform → https://<api>/v1/market/xendit/account
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MASTER_ACCOUNT_ID=
MARKET_LISTING_FEE=15000
MARKET_LISTING_DAYS=30
MARKET_BOOST_FEE=10000
MARKET_BOOST_DAYS=7
MARKET_FEE_PERCENT=5
MARKET_FEE_FLAT=0
# Naikkan bersama naskah web/site/kebijakan-transaksi/ jika kebijakan transaksi diubah.
MARKET_POLICY_VERSION=2026-11-12
# Opsional, JSON host → template afiliasi berisi {url}, mis. {"shopee.co.id":"https://…{url}…"}. Kosong = tautan asli.
AFFILIATE_TEMPLATES=

# --- Banner sponsor (modul 3.3), dibayar di dasbor web lewat Midtrans ---
# Tarif rupiah per hari per kota sasaran; banner nasional = tarif × BANNER_NATIONAL_FACTOR.
BANNER_PRICE_HOME=50000
BANNER_PRICE_EVENTS=40000
BANNER_PRICE_EVENT_DETAIL=30000
BANNER_NATIONAL_FACTOR=5
